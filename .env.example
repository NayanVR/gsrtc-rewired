# Build-time Sentry error + performance monitoring (optional). Leave unset to
# disable. Docker Compose passes this only as a Docker build argument.
VITE_SENTRY_DSN=

# Local development storage. See src/db/README.md for local setup.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gsrtc_rewired

# Better Auth session encryption/signing secret. Generate 32+ characters with
# `bunx auth@1.7.1 secret`; do not commit a real value.
BETTER_AUTH_SECRET=

# Public base URL used by Better Auth for same-origin cookie sessions.
BETTER_AUTH_URL=http://localhost:3000

# Testing-only mock SMS delivery. The login page displays the generated code
# only when this is "mock"; leave it blank when using a real SMS provider.
OTP_DELIVERY_MODE=mock

# Payments default to the local mock provider. Set PAYMENTS_PROVIDER=dodo only
# with Dodo Payments test-dashboard credentials and Pay-What-You-Want INR
# products. The application hardcodes Dodo's test environment.
PAYMENTS_PROVIDER=mock
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PRODUCT_ID_BOOKING=
DODO_PRODUCT_ID_WALLET=

# VPS production values. Set these in Dokploy's Compose Environment editor.
# Docker Compose interpolates them into the required service environments; it
# does not load an env_file into any container.
# URL-encode any reserved characters in the password used in DATABASE_URL.
# POSTGRES_PASSWORD=replace-with-a-long-random-password
# DATABASE_URL=postgres://postgres:replace-with-a-long-random-password@db:5432/gsrtc_rewired
# BETTER_AUTH_URL=https://bus.example.com
# OTP_DELIVERY_MODE=mock
# PAYMENTS_PROVIDER=dodo
# DODO_PAYMENTS_API_KEY=your_test_api_key
# DODO_PAYMENTS_WEBHOOK_KEY=your_test_webhook_secret
# DODO_PRODUCT_ID_BOOKING=your_booking_pwyw_product
# DODO_PRODUCT_ID_WALLET=your_wallet_pwyw_product
